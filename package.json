{
  "name": "caxio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@caxio/*' dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '@caxio/*' typecheck",
    "test": "bun test",
    "build": "bun run --filter '@caxio/*' build",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/bun": "1.3.6",
    "typescript": "^7.0.2"
  }
}
